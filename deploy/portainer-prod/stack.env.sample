#=====================================================================#
#                       LiteLLM Configuration                         #
#=====================================================================#
LITELLM_MASTER_KEY=UPDATE_ME
DATABASE_URL="postgresql://psql:UPDATE_ME@postgres:5432/litellm"
STORE_MODEL_IN_DB = "True"

# LiteLLM access used by the admin app and the custom chat frontends
LITELLM_API_KEY=UPDATE_ME
LITELLM_URL=http://litellm:4000

#=====================================================================#
#                       Admin Configuration                           #
#=====================================================================#
# The admin app stores its data in Postgres (a dedicated `admin` database it
# creates on boot). ENCRYPTION_KEY protects secrets at rest (e.g. proxy API
# keys) with AES-256-GCM; generate with `openssl rand -hex 32`.
ADMIN_DATABASE_URL=postgresql://psql:UPDATE_ME@postgres:5432/admin
ADMIN_ENCRYPTION_KEY=UPDATE_ME

REDIS_PASSWORD=UPDATE_ME
LANGFLOW_DATABASE_URL=postgresql://psql:UPDATE_ME@postgres:5432/langflow
LANGFLOW_CONFIG_DIR=app/langflow
LANGFLOW_COMPONENTS_PATH=/app/custom_components/
LANGFLOW_LOG_LEVEL=info
LANGFLOW_PROMETHEUS_ENABLE=true
# Auth hardening (added 2026-05 after CVE-2025-3248 incident)
LANGFLOW_AUTO_LOGIN=False
LANGFLOW_NEW_USER_IS_ACTIVE=False
LANGFLOW_SUPERUSER=administrator
LANGFLOW_SUPERUSER_PASSWORD=UPDATE_ME
LANGFLOW_SECRET_KEY=UPDATE_ME
CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=UPDATE_ME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=UPDATE_ME
DATABASE_URL=postgresql://psql:UPDATE_ME@postgres:5432/postgres
SALT=UPDATE_ME
ENCRYPTION_KEY=UPDATE_ME
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=UPDATE_ME
CLICKHOUSE_CLUSTER_ENABLED=false

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=UPDATE_ME
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=UPDATE_ME
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

LANGFUSE_INGESTION_QUEUE_DELAY_MS=
LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=UPDATE_ME
REDIS_TLS_ENABLED=false
REDIS_TLS_CA=/certs/ca.crt
REDIS_TLS_CERT=/certs/redis.crt
REDIS_TLS_KEY=/certs/redis.key

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=mysecret

LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
POSTGRES_USER=psql
POSTGRES_PASSWORD=UPDATE_ME
POSTGRES_DB=langflow
