#=====================================================================#
#                       LiteLLM Configuration                         #
#=====================================================================#
LITELLM_MASTER_KEY=UPDATE_ME
LITELLM_DATABASE_URL=postgresql://psql:UPDATE_ME@postgres:5432/litellm
STORE_MODEL_IN_DB="True"

# LiteLLM access used by the admin app and the custom chat frontends
LITELLM_API_KEY=UPDATE_ME
LITELLM_URL=http://litellm:4000

# Langfuse tracing configuration (LiteLLM -> Langfuse)
# Use the Docker service name for internal communication
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=UPDATE_ME
LANGFUSE_SECRET_KEY=UPDATE_ME

#=====================================================================#
#                       Admin Configuration                           #
#=====================================================================#
# The admin app stores its data in Postgres (a dedicated `admin` database it
# creates on boot). ENCRYPTION_KEY protects secrets at rest (e.g. proxy API
# keys) with AES-256-GCM; generate with `openssl rand -hex 32`.
ADMIN_DATABASE_URL=postgresql://psql:UPDATE_ME@postgres:5432/admin
ADMIN_ENCRYPTION_KEY=UPDATE_ME

#=====================================================================#
#                       Redis Configuration                           #
#=====================================================================#
REDIS_PASSWORD=UPDATE_ME

#=====================================================================#
#                       LangFlow Configuration                        #
#=====================================================================#
LANGFLOW_DATABASE_URL=postgresql://psql:UPDATE_ME@postgres:5432/langflow
LANGFLOW_CONFIG_DIR=app/langflow
LANGFLOW_COMPONENTS_PATH=/app/custom_components/
LANGFLOW_LOG_LEVEL=info
LANGFLOW_PROMETHEUS_ENABLE=true
# Auth hardening (added 2026-05 after CVE-2025-3248 incident)
LANGFLOW_AUTO_LOGIN=False
LANGFLOW_NEW_USER_IS_ACTIVE=False
LANGFLOW_SUPERUSER=administrator
LANGFLOW_SUPERUSER_PASSWORD=UPDATE_ME
LANGFLOW_SECRET_KEY=UPDATE_ME

#=====================================================================#
#                       ClickHouse Configuration                      #
#=====================================================================#
CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=UPDATE_ME

#=====================================================================#
#                       MinIO Configuration                           #
#=====================================================================#
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=UPDATE_ME

#=====================================================================#
#                       LangFuse Configuration                        #
#=====================================================================#
LANGFUSE_DATABASE_URL=postgresql://psql:UPDATE_ME@postgres:5432/postgres
SALT=UPDATE_ME
ENCRYPTION_KEY=UPDATE_ME
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=UPDATE_ME
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=UPDATE_ME
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

LANGFUSE_INGESTION_QUEUE_DELAY_MS=
LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=UPDATE_ME
REDIS_TLS_ENABLED=false
REDIS_TLS_CA=/certs/ca.crt
REDIS_TLS_CERT=/certs/redis.crt
REDIS_TLS_KEY=/certs/redis.key

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=mysecret

LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
#=====================================================================#
#                       PostgreSQL Configuration                      #
#=====================================================================#
POSTGRES_USER=psql
POSTGRES_PASSWORD=UPDATE_ME
POSTGRES_DB=langflow

#=====================================================================#
#                       N8N Configuration                             #
#=====================================================================#
# Note: Generic vars like NODE_ENV and WEBHOOK_URL are set in the n8n
# service's environment block in docker-compose.yml to avoid leaking
# into other services via the shared env_file.

# Host Configuration
# Update these to match your deployment hostname
N8N_HOST=UPDATE_ME
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=UPDATE_ME

# Settings
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true

# Timezone
GENERIC_TIMEZONE=America/New_York

# Database (optional - n8n can use SQLite by default)
# N8N_DATABASE_TYPE=postgresdb
# N8N_DATABASE_POSTGRESDB_HOST=postgres
# N8N_DATABASE_POSTGRESDB_PORT=5432
# N8N_DATABASE_POSTGRESDB_DATABASE=n8n
# N8N_DATABASE_POSTGRESDB_USER=psql
# N8N_DATABASE_POSTGRESDB_PASSWORD=UPDATE_ME

# Security (optional)
# N8N_ENCRYPTION_KEY=UPDATE_ME

#=====================================================================#
#                       Open WebUI Configuration                      #
#=====================================================================#
WEBUI_URL=http://localhost:7600

#=====================================================================#
#                       RagFlow Configuration                         #
#=====================================================================#
# RagFlow uses shared postgres, minio, and redis services
# Reuses: POSTGRES_USER, POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD, REDIS_PASSWORD

# RagFlow Postgres database name (uses shared postgres service)
POSTGRES_DBNAME=rag_flow
POSTGRES_HOST=postgres

# RagFlow Elasticsearch
ES_HOST=ragflow-es
ES_PORT=9202
ELASTIC_PASSWORD=UPDATE_ME

# RagFlow MinIO connection (uses shared minio service)
MINIO_HOST=minio
MINIO_USER=ragflow
MINIO_PASSWORD=UPDATE_ME
# Note: MINIO_PASSWORD should match MINIO_ROOT_PASSWORD for shared service

# RagFlow Redis connection (uses shared redis service)
REDIS_HOST=redis
# Note: REDIS_PASSWORD is already defined above

# RagFlow service control
ENABLE_WEBSERVER=1
ENABLE_TASKEXECUTOR=1
ENABLE_DATASYNC=0
ENABLE_MCP_SERVER=0
ENABLE_ADMIN_SERVER=0
WORKERS=1

# RagFlow optional settings
REGISTER_ENABLED=1
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
USE_DOCLING=false
USE_MINERU=false
TZ=America/New_York

# RagFlow Elasticsearch Java options
ES_JAVA_OPTS=-Xms512m -Xmx512m
