#!/usr/bin/env bash
# PREAA instance bootstrap (Amazon Linux 2023).
# Idempotent-ish: safe to re-run. Prepares the data volume, swap, Docker, and a
# self-contained deploy mechanism (systemd unit + SSM-rendered env). There is
# NO external management dependency (no Portainer agent): the box manages its
# own compose stack. The compose files are the in-repo source of truth and are
# placed in /opt/preaa out of band (see README).
set -euxo pipefail

# --- Data volume: find, format (once), mount at /data -----------------------
# On Nitro instances the requested device (${data_volume_device}) surfaces as a
# /dev/nvme*n1 disk with a non-deterministic name, so locate the data disk as
# the single unpartitioned, unmounted disk that is not the root disk. The
# volume attaches a few seconds AFTER boot, so poll for it (up to ~150s) rather
# than racing it.
find_data_dev() {
  local root_disk dev
  root_disk="$(lsblk -ndo PKNAME "$(findmnt -no SOURCE /)" | head -n1 || true)"
  for dev in $(lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print $1}'); do
    [ "$dev" = "$root_disk" ] && continue
    # already-formatted PREAA data disk (label) — reuse on reboot/re-run
    if [ "$(lsblk -no LABEL "/dev/$dev")" = "preaa-data" ]; then echo "/dev/$dev"; return; fi
    # otherwise the first unpartitioned, filesystem-less disk
    if [ -z "$(lsblk -no FSTYPE "/dev/$dev")" ] && [ -z "$(lsblk -no NAME "/dev/$dev" | tail -n +2)" ]; then
      echo "/dev/$dev"; return
    fi
  done
}

data_dev=""
for _ in $(seq 1 30); do
  data_dev="$(find_data_dev)"
  [ -n "$data_dev" ] && break
  sleep 5
done

mkdir -p /data
if [ -n "$data_dev" ]; then
  if [ "$(lsblk -no FSTYPE "$data_dev")" != "ext4" ]; then
    mkfs.ext4 -L preaa-data "$data_dev"
  fi
  grep -q '^LABEL=preaa-data' /etc/fstab || echo 'LABEL=preaa-data /data ext4 defaults,nofail 0 2' >> /etc/fstab
  mount -a
fi

# --- Swap: RAM-spike safety net (plan D1) -----------------------------------
if [ "${swap_size_gb}" -gt 0 ] && [ ! -f /data/swapfile ]; then
  fallocate -l ${swap_size_gb}G /data/swapfile || dd if=/dev/zero of=/data/swapfile bs=1M count=$(( ${swap_size_gb} * 1024 ))
  chmod 600 /data/swapfile
  mkswap /data/swapfile
  swapon /data/swapfile
  grep -q '/data/swapfile' /etc/fstab || echo '/data/swapfile none swap sw 0 0' >> /etc/fstab
  sysctl -w vm.swappiness=10
  grep -q '^vm.swappiness' /etc/sysctl.d/99-preaa.conf 2>/dev/null || echo 'vm.swappiness=10' > /etc/sysctl.d/99-preaa.conf
fi

# --- Elasticsearch needs a high vm.max_map_count (RagFlow ES) ---------------
sysctl -w vm.max_map_count=262144
grep -q '^vm.max_map_count' /etc/sysctl.d/99-preaa.conf 2>/dev/null || echo 'vm.max_map_count=262144' >> /etc/sysctl.d/99-preaa.conf

# --- Docker + compose plugin ------------------------------------------------
dnf install -y docker
# Point Docker's data-root at the big data volume so images/volumes live there.
mkdir -p /data/docker /etc/docker
if [ ! -f /etc/docker/daemon.json ]; then
  echo '{ "data-root": "/data/docker" }' > /etc/docker/daemon.json
fi
systemctl enable --now docker

# Compose v2 plugin (AL2023's docker package doesn't bundle it).
mkdir -p /usr/libexec/docker/cli-plugins
if [ ! -x /usr/libexec/docker/cli-plugins/docker-compose ]; then
  curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
    -o /usr/libexec/docker/cli-plugins/docker-compose
  chmod +x /usr/libexec/docker/cli-plugins/docker-compose
fi

# --- AWS CLI (used to render secrets from SSM) ------------------------------
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y unzip || true
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  (cd /tmp && unzip -q awscliv2.zip && ./aws/install)
fi

# --- Self-contained deploy: /opt/preaa + SSM->env render + systemd unit ------
# No external orchestrator. The compose files (in-repo source of truth) are
# placed in /opt/preaa out of band; this sets up how the host runs them.
install -d -m 750 /opt/preaa

# Render stack.env from the SSM SecureString parameters under the env prefix.
cat > /opt/preaa/render-env.sh <<RENDER
#!/usr/bin/env bash
set -euo pipefail
umask 077
OUT=/opt/preaa/stack.env
: > "\$OUT"
aws ssm get-parameters-by-path --region "${region}" --path "${ssm_prefix}" \
  --with-decryption --query 'Parameters[].[Name,Value]' --output text \
  | while IFS=\$'\t' read -r name value; do
      echo "\$(basename "\$name")=\$value" >> "\$OUT"
    done
RENDER
chmod +x /opt/preaa/render-env.sh

# systemd unit: render env, then bring the compose stack up.
cat > /etc/systemd/system/preaa.service <<'UNIT'
[Unit]
Description=PREAA docker compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/preaa
ExecStartPre=/opt/preaa/render-env.sh
ExecStart=/usr/bin/docker compose --env-file /opt/preaa/stack.env up -d
ExecStop=/usr/bin/docker compose --env-file /opt/preaa/stack.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable preaa.service
# Not started here — place the compose file(s) in /opt/preaa first, then:
#   systemctl start preaa.service

echo "PREAA host bootstrap complete."
