# PREAA AWS — NON-SECRET base config (committed).
#
# At deploy, render-env.sh concatenates this file with the SecureString secrets
# from SSM (/preaa/<env>/*) to produce /opt/preaa/stack.env. Secrets (passwords,
# keys) live ONLY in SSM. DB connection strings that embed the password are
# built in docker-compose.yml via ${POSTGRES_PASSWORD} interpolation, so they
# are not stored here either.
#
# Values marked "set per env" depend on the public hostnames / DNS and must be
# overridden once the domain scheme is decided (see MIGRATION-PLAN D7).

# --- Postgres (shared) ---
POSTGRES_USER=psql
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- LiteLLM ---
STORE_MODEL_IN_DB=True
LITELLM_URL=http://litellm:4000
LITELLM_BASE_URL=http://litellm:4000

# --- Langfuse (LiteLLM tracing target) ---
LANGFUSE_HOST=http://langfuse-web:3000
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true
# Seed a project on first boot with the public/secret keys from SSM.
LANGFUSE_INIT_ORG_ID=preaa
LANGFUSE_INIT_ORG_NAME=PREAA
LANGFUSE_INIT_PROJECT_ID=preaa
LANGFUSE_INIT_PROJECT_NAME=PREAA

# --- ClickHouse (Langfuse) ---
CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false

# --- MinIO (object storage; S3-compatible) ---
MINIO_ROOT_USER=minio
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

# --- Redis (shared) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS_ENABLED=false

# --- LangFlow ---
LANGFLOW_CONFIG_DIR=/app/langflow
LANGFLOW_COMPONENTS_PATH=/app/custom_components/
LANGFLOW_LOG_LEVEL=info
LANGFLOW_PROMETHEUS_ENABLE=false
LANGFLOW_AUTO_LOGIN=False
LANGFLOW_NEW_USER_IS_ACTIVE=False
LANGFLOW_SUPERUSER=administrator

# --- n8n ---
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_RUNNERS_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=America/New_York
# set per env: N8N_HOST, N8N_WEBHOOK_URL / WEBHOOK_URL (public hostname)
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# --- RagFlow ---
RAGFLOW_DB_TYPE=postgres
DOC_ENGINE=elasticsearch
POSTGRES_DBNAME=rag_flow
ES_HOST=ragflow-es
ES_PORT=9202
MINIO_HOST=minio
MINIO_USER=minio
REDIS_DB=1
ENABLE_WEBSERVER=1
ENABLE_TASKEXECUTOR=1
ENABLE_DATASYNC=0
ENABLE_MCP_SERVER=0
ENABLE_ADMIN_SERVER=0
WORKERS=1
REGISTER_ENABLED=1
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
USE_DOCLING=false
USE_MINERU=false
TZ=America/New_York
ES_JAVA_OPTS=-Xms512m -Xmx512m
STACK_VERSION=8.11.3
MEM_LIMIT=4294967296

# --- Open WebUI ---
# set per env: WEBUI_URL (public hostname)
WEBUI_URL=http://localhost:7600

# --- Admin ---
# set per env: ALLOWED_ORIGINS (embedded-chat origin), NEXTAUTH_URL, KEYCLOAK_*
ALLOWED_ORIGINS=*
